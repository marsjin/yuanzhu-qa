# 必填：DeepSeek API Key（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-你的密钥

# 可选：模型与端点
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1

# 可选：原文无据时是否允许通用知识补充（0=拒答并建议转人工）
# CS_GENERAL_FALLBACK=0

# 可选：Agent 计划生成方式（rules=规则模板，省 1 次调用；llm=模型生成）
# CS_PLAN_MODE=rules

# 可选：页面与全部接口的 HTTP Basic 鉴权；配置密码后启用
# 鉴权：admin 可访问全部页面与接口，user 仅可对话（不能访问 /admin 与 /events/stats）
# 账号密码固定从配置读取，不支持在线修改
# CS_AUTH_USERNAME=admin
# CS_AUTH_PASSWORD=请替换为强密码
# CS_AUTH_USER_USERNAME=user
# CS_AUTH_USER_PASSWORD=change-me-user
# 额外 user 账号，格式 name:password，多个用英文逗号分隔
# CS_AUTH_EXTRA_USERS=jerry:change-me-extra
# 登录有效期（分钟），登录后写入 Cookie，退出即失效
# CS_AUTH_SESSION_MINUTES=60

# 外链来源标识（写进豆瓣链接的 from / utm_source，便于对方区分来路）
# CS_REFERRAL_TAG=cs.brandex.top

# 可选：反代信任的 IP。容器经 docker-proxy 转发时为 172.x 网段；仅本机反代可达容器时可保持 *
# CS_FORWARDED_ALLOW_IPS=*

# 可选：向量检索（本地小模型，不消耗大模型调用）；0=只走 BM25
# CS_EMBED=1
# CS_EMBED_MODEL=BAAI/bge-small-zh-v1.5

# 可选：检索不足时用大模型改写查询词（向量可用时建议保持关闭）
# CS_QUERY_REWRITE=0
